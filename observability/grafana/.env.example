# Copy to `.env` (which is gitignored) and fill in.

# --- Grafana admin (first login) ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# --- Local Postgres store (`docker compose --profile store-postgres up`) ---
# Defaults match the root compose.yaml store-postgres profile; usually no need to change these.
# host.docker.internal lets the Grafana container reach the store on your host.
LOCAL_DB_HOST=host.docker.internal
LOCAL_DB_PORT=5433
LOCAL_DB_NAME=tutors
LOCAL_DB_USER=tutors
LOCAL_DB_PASSWORD=tutors

# --- Staging Postgres store (remote) ---
# Point at the read-only grafana_reader role (see sql/grafana_reader.sql), NOT
# the servers' own database user. Leave STAGING_DB_HOST empty to disable the staging source.
STAGING_DB_HOST=
STAGING_DB_PORT=5432
STAGING_DB_NAME=tutors
STAGING_DB_USER=grafana_reader
STAGING_DB_PASSWORD=
STAGING_DB_SSLMODE=require
