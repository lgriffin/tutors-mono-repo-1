# Anonymous Mode
# TRUE disables authentication, presence and analytics, so the apps run with
# no backend at all. This is the right setting for local development and for
# public demo deployments. Set it to FALSE (or blank) and fill in the Supabase
# and GitHub values below to run against a real backend.
PUBLIC_ANON_MODE=TRUE

# Runtime destinations for links between the four apps (no rebuild required).
PUBLIC_READER_ORIGIN=https://tutors.dev
PUBLIC_CATALOGUE_ORIGIN=https://catalogue.tutors.dev
PUBLIC_LIVE_ORIGIN=https://live.tutors.dev
PUBLIC_TIME_ORIGIN=https://time.tutors.dev

# Supabase Configuration (ignored while PUBLIC_ANON_MODE=TRUE)
# Get these from your Supabase project settings → API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service_role key (reader and time servers only; ignored while PUBLIC_ANON_MODE=TRUE)
# The reader's /api routes save and read student data with it, after checking the
# session; POST /api/gists and the time app's snippets page reach course_gists
# (closed to the anon role) with it; the time app's Moodle sync writes with it. It
# bypasses Row-Level Security entirely: keep it in a secret, never in a PUBLIC_
# variable or a browser. Leave empty to run without the data API and snippet sharing.
PRIVATE_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Origins of the other apps the reader's data API answers (reader app only):
# the time dashboard reads /api/time with the reader's session cookie; the
# catalogue, live and time apps post error reports, and live its watcher reports.
# Comma-separated.
PRIVATE_API_ALLOWED_ORIGINS=https://time.tutors.dev,https://catalogue.tutors.dev,https://live.tutors.dev

# GitHub logins that count as an educator of every course (reader app only), on
# top of each course's enrollment.yaml educators. Comma-separated; usually empty.
PRIVATE_TUTORS_ADMINS=

# Hosts other than *.netlify.app that serve courses (reader app only). The server
# fetches tutors.json from them to read a course's educators. Comma-separated.
PRIVATE_COURSE_HOSTS=

# The reader whose data API the catalogue, live and time apps read through: the
# host people sign in at, since the reader's session cookie is host-only.
PUBLIC_READER_URL=https://tutors.dev

# GitHub OAuth (reader and time apps; ignored while PUBLIC_ANON_MODE=TRUE)
# Create a GitHub OAuth App at https://github.com/settings/developers. The time
# app signs educators in for the shared-snippets page, so its host needs its
# own callback URL (https://<time-host>/api/auth/callback/github) registered,
# on a second OAuth App when both apps are served from different hosts.
PRIVATE_AUTH_GITHUB_ID=your-github-oauth-app-id
PRIVATE_AUTH_GITHUB_SECRET=your-github-oauth-app-secret

# Session signing/encryption secret (reader and time apps)
# Must be at least 32 characters. Generate with: openssl rand -base64 32
PRIVATE_AUTH_SECRET=your-secret-key-at-least-32-chars-long

# Adobe PDF Embed API key (for TalkAdobe component)
PUBLIC_PDF_KEY=your-adobe-pdf-key

# Moodle web-service endpoint (time app only)
MOODLE_WS_URL=https://your-moodle.example.com/webservice/rest/server.php
MOODLE_WS_TOKEN=your-moodle-ws-token
MOODLE_WS_REST_FORMAT=json

# Moodle sync interval in minutes (time app only)
SYNC_INTERVAL_MINUTES=60

# Server log verbosity: debug | info | warn | error (all apps)
# Defaults to info in production and debug in dev. Logs are JSON lines in production.
LOG_LEVEL=

# Release harness only: freezes the server clock used for response and record
# timestamps at one ISO 8601 instant, so two stacks answer identical bytes.
# Never set this in a real deployment; the apps log a warning at startup and
# GET /version reports "clock": "frozen" while it is set. Left commented out on
# purpose (this file is also the container smoke test's env file).
# HARNESS_NOW=2026-09-16T09:05:00.000Z

# Prometheus scrape token (all apps). When set, GET /metrics requires
# "Authorization: Bearer <token>"; leave empty to keep the endpoint open.
METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Tutors Live (stats and heat maps)
# ---------------------------------------------------------------------------

# Where the reader posts live events. Unset disables the emitter entirely, which
# is the default: no endpoint, no events, no change to how the reader behaves.
# e.g. http://localhost:3002/api/live/events
PUBLIC_LIVE_EVENTS_URL=

# Pipeline adapters (live app and services/live-ingest). Every one defaults to
# "memory", which makes a single live container a complete working pipeline.
#   LIVE_BUS         memory | redis
#   LIVE_HOT_STORE   memory | valkey
#   LIVE_WAREHOUSE   memory | postgres
LIVE_BUS=
LIVE_HOT_STORE=
LIVE_WAREHOUSE=

# Connection strings for the networked adapters.
LIVE_REDIS_URL=
LIVE_DATABASE_URL=

# Days of raw events to keep. Aggregates outlive them.
LIVE_RETENTION_DAYS=90

# Whether the live app also runs the ingest consumer. Defaults to TRUE on the
# memory bus (nothing else can see those events) and FALSE on redis, where
# services/live-ingest owns the job.
LIVE_INGEST_IN_PROCESS=

# Term windows for the out-of-term observation, as JSON. With none set that rule
# stays quiet.
# e.g. [{"name":"Semester 1","from":"2026-09-07","to":"2026-12-18"}]
LIVE_TERMS=
