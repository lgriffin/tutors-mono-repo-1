# Copy to secrets.yaml (git-ignored), fill in, then:
#   oc apply -f deploy/k8s/overlays/time/secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: time-tutors-app-secrets
type: Opaque
stringData:
  # Moodle web-service token for the assignment sync.
  MOODLE_WS_TOKEN: ""
  # When set, GET /metrics requires "Authorization: Bearer <token>".
  METRICS_TOKEN: ""
  # GitHub OAuth for the educator sign-in (the shared-snippets page). The
  # callback is https://<time-host>/api/auth/callback/github, so register it
  # on the OAuth App, or on a second one when the reader lives elsewhere.
  PRIVATE_AUTH_GITHUB_ID: ""
  PRIVATE_AUTH_GITHUB_SECRET: ""
  # At least 32 characters: openssl rand -base64 32
  PRIVATE_AUTH_SECRET: ""
